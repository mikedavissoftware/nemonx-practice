// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  @@map("User")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   // Will store the JSON stringified session data
  expiresAt DateTime
}